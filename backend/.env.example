# Backend
APP_ENV=development
APP_ADDR=:8080
JWT_ISSUER=academiq
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=168
LOGIN_LOCKOUT_AFTER=5
JWT_SECRET=change-me

# Preferred: full connection string
DATABASE_URL=postgres://academiq:academiq_password@localhost:5432/academiq?sslmode=disable

# Alternative split DB vars (used only when DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=5432
DB_USER=academiq
DB_PASSWORD=academiq_password
DB_NAME=academiq
DB_SSLMODE=disable

# Frontend
VITE_API_BASE_URL=http://localhost:8080
